[Unit]
Description=MyToken guarded Codex credential importer

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/mytoken-codex-import-runner
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077
ReadWritePaths=/var/lib/mytoken /run/mytoken
TimeoutStartSec=5min
