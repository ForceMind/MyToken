#!/bin/sh
set -eu

# This file intentionally has no command/ref/repository input. The API writes
# only a marker; all update parameters below are immutable deployment policy.
request_path=/var/lib/mytoken/api/update-request.json
status_path=/var/lib/mytoken/update/status.json
lock_path=/var/lib/mytoken/update/update.lock
source_dir=/srv/mytoken-src
log_path=/var/lib/mytoken/update/update.log

mkdir -p /var/lib/mytoken/update /var/cache/mytoken-update
exec 9>"$lock_path"
if ! flock -n 9; then exit 0; fi
if [ ! -f "$request_path" ]; then exit 0; fi
rm -f -- "$request_path"

write_status() {
  status="$1"
  message="$2"
  version="${3:-null}"
  now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  temporary="${status_path}.tmp.$$"
  umask 077
  # Message is generated locally and bounded before being embedded as JSON.
  message="$(printf '%s' "$message" | cut -c 1-512)"
  version="$(printf '%s' "$version" | cut -c 1-128)"
  escaped_message=$(printf '%s' "$message" | sed 's/\\/\\\\/g; s/"/\\"/g')
  escaped_version=$(printf '%s' "$version" | sed 's/\\/\\\\/g; s/"/\\"/g')
  printf '{"status":"%s","version":%s,"requestedAt":null,"startedAt":%s,"finishedAt":%s,"message":"%s"}\n' \
    "$status" \
    "$(if [ "$version" = null ]; then printf null; else printf '"%s"' "$escaped_version"; fi)" \
    "$(if [ "$status" = running ]; then printf '"%s"' "$now"; else printf null; fi)" \
    "$(if [ "$status" = running ]; then printf null; else printf '"%s"' "$now"; fi)" \
    "$escaped_message" > "$temporary"
  chown root:mytoken-api "$temporary"
  chmod 0640 "$temporary"
  mv -f "$temporary" "$status_path"
}

if [ ! -d "$source_dir/.git" ]; then
  write_status failed "GitHub source checkout is missing"
  exit 1
fi
if ! origin="$(git -C "$source_dir" remote get-url origin)"; then
  write_status failed "Unable to read GitHub source origin"
  exit 1
fi
case "$origin" in
  https://github.com/ForceMind/MyToken.git|git@github.com:ForceMind/MyToken.git) ;;
  *) write_status failed "GitHub source origin is not trusted"; exit 1 ;;
esac
if [ -n "$(git -C "$source_dir" status --porcelain)" ]; then
  write_status failed "Source checkout has uncommitted changes"
  exit 1
fi
if ! git -C "$source_dir" fetch --force --tags origin; then
  write_status failed "GitHub tag fetch failed"
  exit 1
fi
target_tag="$(git -C "$source_dir" tag --list 'v[0-9]*' | \
  node "$source_dir/deploy/scripts/select-release-tag.mjs")"
if [ -z "$target_tag" ]; then
  write_status failed "GitHub has no valid release tag"
  exit 1
fi
target_version="${target_tag#v}"
target_git_head="$(git -C "$source_dir" rev-list -n 1 "$target_tag")"
if ! printf '%s' "$target_git_head" | grep -Eq '^[a-f0-9]{40}$'; then
  write_status failed "GitHub release commit is invalid"
  exit 1
fi
if ! package_version="$(git -C "$source_dir" show "$target_tag:packages/cli/package.json" | \
  node -e 'let s=""; process.stdin.on("data", d => s += d); process.stdin.on("end", () => process.stdout.write(JSON.parse(s).version || ""))')"; then
  write_status failed "GitHub release package metadata is invalid"
  exit 1
fi
if [ "$package_version" != "$target_version" ]; then
  write_status failed "GitHub tag and package version do not match"
  exit 1
fi

write_status running "Verified GitHub update started" "$target_version"
if ! git -C "$source_dir" checkout --detach "$target_tag"; then
  write_status failed "GitHub release checkout failed" "$target_version"
  exit 1
fi

# Keep updater output out of the status file and cap the retained diagnostic.
set +e
timeout 30m env MYTOKEN_SOURCE_DIR="$source_dir" \
  "$source_dir/deploy/install.sh" >"$log_path.tmp.$$" 2>&1
exit_code=$?
set -e
tail -c 65536 "$log_path.tmp.$$" > "$log_path" || true
rm -f -- "$log_path.tmp.$$"
chmod 0600 "$log_path"

if [ "$exit_code" -eq 0 ]; then
  write_status success "GitHub update completed" "$target_version"
else
  write_status failed "Update failed (exit $exit_code)" "$target_version"
fi
exit "$exit_code"
