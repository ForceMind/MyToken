#!/bin/sh
set -eu

# This file intentionally has no command/ref/repository input. The API writes
# only a marker; all update parameters below are immutable deployment policy.
request_path=/var/lib/mytoken/api/update-request.json
status_path=/var/lib/mytoken/update/status.json
lock_path=/var/lib/mytoken/update/update.lock
source_dir=/srv/mytoken-src
log_path=/var/lib/mytoken/update/update.log

mkdir -p /var/lib/mytoken/update /var/cache/mytoken-update
exec 9>"$lock_path"
if ! flock -n 9; then exit 0; fi
if [ ! -f "$request_path" ]; then exit 0; fi

write_status() {
  status="$1"
  message="$2"
  version="${3:-null}"
  now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  temporary="${status_path}.tmp.$$"
  umask 077
  # Message is generated locally and bounded before being embedded as JSON.
  message="$(printf '%s' "$message" | cut -c 1-512)"
  version="$(printf '%s' "$version" | cut -c 1-128)"
  escaped_message=$(printf '%s' "$message" | sed 's/\\/\\\\/g; s/"/\\"/g')
  escaped_version=$(printf '%s' "$version" | sed 's/\\/\\\\/g; s/"/\\"/g')
  printf '{"status":"%s","version":%s,"requestedAt":null,"startedAt":%s,"finishedAt":%s,"message":"%s"}\n' \
    "$status" \
    "$(if [ "$version" = null ]; then printf null; else printf '"%s"' "$escaped_version"; fi)" \
    "$(if [ "$status" = running ]; then printf '"%s"' "$now"; else printf null; fi)" \
    "$(if [ "$status" = running ]; then printf null; else printf '"%s"' "$now"; fi)" \
    "$escaped_message" > "$temporary"
  chown root:mytoken-api "$temporary"
  chmod 0640 "$temporary"
  mv -f "$temporary" "$status_path"
}

target_version="$(npm view mytoken-gateway@preview version)"
case "$target_version" in
  [0-9]*.[0-9]*.[0-9]*-preview.[0-9]*) ;;
  *) write_status failed "Registry returned an invalid preview version"; exit 1 ;;
esac
target_integrity="$(npm view "mytoken-gateway@$target_version" dist.integrity)"
target_git_head="$(npm view "mytoken-gateway@$target_version" gitHead)"
case "$target_integrity" in sha512-*) ;; *) write_status failed "Release integrity is missing"; exit 1 ;; esac
if ! printf '%s' "$target_git_head" | grep -Eq '^[a-f0-9]{40}$'; then
  write_status failed "Release commit metadata is missing"
  exit 1
fi

write_status running "Verified update started" "$target_version"
rm -f -- "$request_path"

# Keep updater output out of the status file and cap the retained diagnostic.
set +e
timeout 30m npx --yes "mytoken-gateway@$target_version" update --source "$source_dir" >"$log_path.tmp.$$" 2>&1
exit_code=$?
set -e
tail -c 65536 "$log_path.tmp.$$" > "$log_path" || true
rm -f -- "$log_path.tmp.$$"
chmod 0600 "$log_path"

if [ "$exit_code" -eq 0 ]; then
  write_status success "Update completed" "$target_version"
else
  write_status failed "Update failed (exit $exit_code)" "$target_version"
fi
exit "$exit_code"
