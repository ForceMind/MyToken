#!/bin/sh
set -eu

environment_file="${MYTOKEN_ENV_FILE:-/etc/mytoken/mytoken.env}"
install_dir="${MYTOKEN_INSTALL_DIR:-/opt/mytoken}"

as_root() {
  if [ "$(id -u)" -eq 0 ]; then
    "$@"
  else
    sudo "$@"
  fi
}

env_value() {
  key="$1"
  if [ ! -r "$environment_file" ]; then
    as_root awk -F= -v wanted="$key" '$1 == wanted { sub(/^[^=]*=/, ""); print; exit }' "$environment_file"
  else
    awk -F= -v wanted="$key" '$1 == wanted { sub(/^[^=]*=/, ""); print; exit }' "$environment_file"
  fi
}

usage() {
  cat <<'EOF'
Usage: mytokenctl COMMAND [ARG]

Commands:
  status                  Show service and endpoint status
  start|stop|restart      Control both services
  logs [api|worker|all]   Follow service logs
  health                  Query /healthz
  ready                   Query /readyz
  codex-status            Show Codex authentication method (never tokens)
  codex-login             Log in the dedicated server Codex identity in this terminal
  codex-import USER       Import file-based Codex login from a Linux user
  provider-status         Show provider configuration without revealing keys
  provider-set ID [FILE]  Store or replace a provider API key, then restart API
  provider-reload         Restart API to reload provider configuration
  permissions             Show important ownership and modes
  doctor                  Show non-sensitive runtime versions and paths
  version-check           Compare deployed package, API, and UI versions
  db-check                Run SQLite integrity_check
  backup                  Create a consistent stopped-service DB backup
  bootstrap-token         Print the one-time bootstrap token to this terminal
  deploy [SOURCE_DIR]     Run the one-click installer from a source tree
  version                 Show deployed MyToken version
EOF
}

command_name="${1:-help}"
case "$command_name" in
  status)
    as_root systemctl status --no-pager mytoken-worker.service mytoken-api.service || true
    "$0" health || true
    "$0" ready || true
    ;;
  start|stop|restart)
    as_root systemctl "$command_name" mytoken-worker.service mytoken-api.service
    ;;
  logs)
    target="${2:-all}"
    case "$target" in
      api) as_root journalctl -u mytoken-api.service -f ;;
      worker) as_root journalctl -u mytoken-worker.service -f ;;
      all) as_root journalctl -u mytoken-api.service -u mytoken-worker.service -f ;;
      *) printf '%s\n' "Unknown log target: $target" >&2; exit 2 ;;
    esac
    ;;
  health)
    curl --fail --show-error --silent http://127.0.0.1:8080/healthz
    printf '\n'
    ;;
  ready)
    curl --fail --show-error --silent http://127.0.0.1:8080/readyz
    printf '\n'
    ;;
  codex-status)
    codex_bin="$(env_value MYTOKEN_CODEX_BIN)"
    codex_home="$(env_value MYTOKEN_CODEX_HOME)"
    as_root runuser -u mytoken-codex -- env \
      HOME="$codex_home" CODEX_HOME="$codex_home" \
      PATH=/usr/local/bin:/usr/bin:/bin \
      "$codex_bin" login status
    ;;
  codex-login)
    codex_bin="$(env_value MYTOKEN_CODEX_BIN)"
    codex_home="$(env_value MYTOKEN_CODEX_HOME)"
    as_root systemctl stop mytoken-worker.service mytoken-api.service || true
    set +e
    as_root runuser -u mytoken-codex -- env \
      HOME="$codex_home" CODEX_HOME="$codex_home" \
      PATH=/usr/local/bin:/usr/bin:/bin \
      "$codex_bin" login --device-auth
    login_status=$?
    set -e
    as_root systemctl start mytoken-worker.service mytoken-api.service
    exit "$login_status"
    ;;
  codex-import)
    source_user="${2:-}"
    case "$source_user" in
      ""|mytoken-codex|*[!a-z0-9_.-]*)
        printf '%s\n' "A valid Linux source user is required." >&2
        exit 2
        ;;
    esac
    case "$source_user" in
      [a-z_]*) ;;
      *) printf '%s\n' "Linux source user must start with a lowercase letter or underscore." >&2; exit 2 ;;
    esac
    request_path=/var/lib/mytoken/api/codex-import-request.json
    if as_root test -e "$request_path" || \
      as_root systemctl is-active --quiet mytoken-codex-import.service; then
      printf '%s\n' "A Codex import request is already pending." >&2
      exit 1
    fi
    if ! as_root env SOURCE_USER="$source_user" REQUEST_PATH="$request_path" \
      /usr/bin/env node -e '
        const fs = require("node:fs");
        const crypto = require("node:crypto");
        const sourceUser = process.env.SOURCE_USER;
        if (!/^[a-z_][a-z0-9_.-]{0,63}$/.test(sourceUser) || sourceUser === "mytoken-codex") process.exit(2);
        const body = { id: crypto.randomBytes(16).toString("hex"), sourceUser, requestedAt: new Date().toISOString(), source: "admin" };
        fs.writeFileSync(process.env.REQUEST_PATH, JSON.stringify(body), { flag: "wx", mode: 0o600 });
      '; then
      printf '%s\n' "Unable to create Codex import request." >&2
      exit 1
    fi
    set +e
    as_root systemctl start mytoken-codex-import.service
    import_status=$?
    set -e
    if as_root test -r /var/lib/mytoken/codex-import/status.json; then
      as_root cat /var/lib/mytoken/codex-import/status.json
    fi
    exit "$import_status"
    ;;
  provider-status)
    provider_config="$(env_value MYTOKEN_PROVIDERS_FILE)"
    as_root env MYTOKEN_PROVIDERS_FILE="$provider_config" /usr/bin/env node -e '
      const fs = require("node:fs");
      const config = JSON.parse(fs.readFileSync(process.env.MYTOKEN_PROVIDERS_FILE, "utf8"));
      for (const provider of config.providers || []) {
        let configured = false;
        try { configured = fs.readFileSync(provider.apiKeyFile, "utf8").trim().length >= 8; }
        catch {}
        console.log(JSON.stringify({
          id: provider.id,
          name: provider.name,
          protocol: provider.protocol,
          enabled: provider.enabled !== false,
          configured
        }));
      }
    '
    ;;
  provider-set)
    provider_id="${2:-}"
    provider_source="${3:-}"
    case "$provider_id" in
      ""|*[!a-z0-9_-]*) printf '%s\n' "Provider ID is required and must be lowercase." >&2; exit 2 ;;
    esac
    provider_config="$(env_value MYTOKEN_PROVIDERS_FILE)"
    secret_path="$(as_root env MYTOKEN_PROVIDERS_FILE="$provider_config" PROVIDER_ID="$provider_id" \
      /usr/bin/env node -e '
        const fs = require("node:fs");
        const config = JSON.parse(fs.readFileSync(process.env.MYTOKEN_PROVIDERS_FILE, "utf8"));
        const provider = (config.providers || []).find((entry) => entry.id === process.env.PROVIDER_ID);
        if (!provider || typeof provider.apiKeyFile !== "string") process.exit(2);
        process.stdout.write(provider.apiKeyFile);
      ')" || {
        printf '%s\n' "Provider is not declared in $provider_config: $provider_id" >&2
        exit 2
    }
    secret_tmp="$(mktemp /var/tmp/mytoken-provider-key.XXXXXX)"
    provider_terminal_hidden=false
    cleanup_provider_key() {
      if [ "$provider_terminal_hidden" = "true" ]; then stty echo; fi
      rm -f -- "$secret_tmp"
    }
    trap cleanup_provider_key EXIT HUP INT TERM
    if [ -n "$provider_source" ]; then
      if [ ! -r "$provider_source" ]; then
        printf '%s\n' "Provider key file is not readable: $provider_source" >&2
        exit 1
      fi
      cp "$provider_source" "$secret_tmp"
    else
      printf 'Enter API key for %s: ' "$provider_id" >&2
      if [ -t 0 ]; then stty -echo; provider_terminal_hidden=true; fi
      IFS= read -r provider_key
      if [ "$provider_terminal_hidden" = "true" ]; then
        stty echo
        provider_terminal_hidden=false
        printf '\n' >&2
      fi
      printf '%s' "$provider_key" > "$secret_tmp"
      unset provider_key
    fi
    if [ "$(wc -c < "$secret_tmp")" -lt 8 ]; then
      printf '%s\n' "Provider API key is too short" >&2
      exit 1
    fi
    as_root install -o mytoken-api -g mytoken-api -m 0600 "$secret_tmp" "$secret_path"
    as_root systemctl restart mytoken-api.service
    printf '%s\n' "Provider key stored and API reloaded: $provider_id"
    ;;
  provider-reload)
    as_root systemctl restart mytoken-api.service
    ;;
  permissions)
    as_root stat -c '%A %U:%G %n' \
      /etc/mytoken /etc/mytoken/secrets \
      /var/lib/mytoken/api /var/lib/mytoken/codex /var/lib/mytoken/workspace \
      /run/mytoken /run/mytoken/worker.sock
    ;;
  doctor)
    printf 'MyToken version: '; "$0" version
    printf 'Node: '; node --version
    printf 'npm: '; npm --version
    codex_bin="$(env_value MYTOKEN_CODEX_BIN)"
    printf 'Codex: '; "$codex_bin" --version
    printf 'Worker socket: %s\n' "$(env_value MYTOKEN_WORKER_SOCKET)"
    printf 'Database: %s\n' "$(env_value MYTOKEN_DB_PATH)"
    "$0" health
    "$0" ready || true
    "$0" version-check || true
    ;;
  version-check)
    deployed_version="$(node -e 'const p=require(process.argv[1]); console.log(p.version)' "$install_dir/packages/cli/package.json" 2>/dev/null || true)"
    configured_version="$(env_value MYTOKEN_VERSION)"
    api_version="$(curl --fail --silent --max-time 5 http://127.0.0.1:8080/versionz 2>/dev/null | \
      node -e 'let s=""; process.stdin.on("data", d => s += d); process.stdin.on("end", () => { try { const p=JSON.parse(s); process.stdout.write(String(p.version || p.apiVersion || p.currentVersion || "")); } catch {} })' || true)"
    ui_version="$(curl --fail --silent --max-time 5 http://127.0.0.1:8080/version.json 2>/dev/null | \
      node -e 'let s=""; process.stdin.on("data", d => s += d); process.stdin.on("end", () => { try { const p=JSON.parse(s); process.stdout.write(String(p.version || "")); } catch {} })' || true)"
    printf 'Deployed package: %s\n' "${deployed_version:-unavailable}"
    printf 'Configured environment: %s\n' "${configured_version:-unavailable}"
    printf 'API /versionz: %s\n' "${api_version:-unavailable}"
    printf 'UI /version.json: %s\n' "${ui_version:-unavailable}"
    if [ -n "$deployed_version" ] && [ "$deployed_version" = "$configured_version" ] && \
      [ "$deployed_version" = "$api_version" ] && [ "$deployed_version" = "$ui_version" ]; then
      printf '%s\n' 'Version status: MATCH'
    else
      printf '%s\n' 'Version status: MISMATCH'
      exit 1
    fi
    ;;
  db-check)
    database_path="$(env_value MYTOKEN_DB_PATH)"
    as_root runuser -u mytoken-api -- env MYTOKEN_DB_PATH="$database_path" \
      /usr/bin/env node -e '
        const { DatabaseSync } = require("node:sqlite");
        const db = new DatabaseSync(process.env.MYTOKEN_DB_PATH, { readOnly: true });
        const row = db.prepare("PRAGMA integrity_check").get();
        db.close();
        if (row.integrity_check !== "ok") process.exit(1);
        console.log(JSON.stringify({ integrity: "ok" }));
      '
    ;;
  backup)
    database_path="$(env_value MYTOKEN_DB_PATH)"
    if [ ! -f "$database_path" ]; then
      printf '%s\n' "Database does not exist: $database_path" >&2
      exit 1
    fi
    api_active=false
    as_root systemctl is-active --quiet mytoken-api.service && api_active=true
    if [ "$api_active" = "true" ]; then as_root systemctl stop mytoken-api.service; fi
    backup_dir="$(dirname -- "$database_path")/backups"
    as_root install -d -o mytoken-api -g mytoken-api -m 0700 "$backup_dir"
    backup_path="$backup_dir/manual-$(date -u +%Y%m%dT%H%M%SZ).sqlite"
    if ! as_root runuser -u mytoken-api -- env MYTOKEN_DB_PATH="$database_path" \
      /usr/bin/env node -e '
        const { DatabaseSync } = require("node:sqlite");
        const db = new DatabaseSync(process.env.MYTOKEN_DB_PATH);
        db.exec("PRAGMA wal_checkpoint(TRUNCATE)");
        const row = db.prepare("PRAGMA integrity_check").get();
        db.close();
        if (row.integrity_check !== "ok") process.exit(1);
      '; then
      if [ "$api_active" = "true" ]; then as_root systemctl start mytoken-api.service; fi
      printf '%s\n' "Database checkpoint or integrity check failed" >&2
      exit 1
    fi
    if ! as_root cp --preserve=mode,ownership,timestamps "$database_path" "$backup_path"; then
      if [ "$api_active" = "true" ]; then as_root systemctl start mytoken-api.service; fi
      printf '%s\n' "Database backup failed" >&2
      exit 1
    fi
    if ! as_root runuser -u mytoken-api -- env MYTOKEN_DB_PATH="$backup_path" \
      /usr/bin/env node -e '
        const { DatabaseSync } = require("node:sqlite");
        const db = new DatabaseSync(process.env.MYTOKEN_DB_PATH, { readOnly: true });
        const row = db.prepare("PRAGMA integrity_check").get();
        db.close();
        if (row.integrity_check !== "ok") process.exit(1);
      '; then
      if [ "$api_active" = "true" ]; then as_root systemctl start mytoken-api.service; fi
      printf '%s\n' "Backup integrity check failed: $backup_path" >&2
      exit 1
    fi
    if [ "$api_active" = "true" ]; then as_root systemctl start mytoken-api.service; fi
    printf '%s\n' "$backup_path"
    ;;
  bootstrap-token)
    database_path="$(env_value MYTOKEN_DB_PATH)"
    if [ -f "$database_path" ] && as_root runuser -u mytoken-api -- env MYTOKEN_DB_PATH="$database_path" \
      /usr/bin/env node -e '
        const { DatabaseSync } = require("node:sqlite");
        const db = new DatabaseSync(process.env.MYTOKEN_DB_PATH, { readOnly: true });
        const initialized = Boolean(db.prepare("SELECT 1 FROM admin_users LIMIT 1").get());
        db.close();
        process.exit(initialized ? 0 : 1);
      '; then
      printf '%s\n' "Administrator is already initialized; the bootstrap token is no longer usable." >&2
      exit 1
    fi
    printf '%s\n' "Sensitive: this token is displayed only in your current terminal." >&2
    as_root cat /etc/mytoken/secrets/bootstrap-token
    printf '\n'
    ;;
  deploy)
    source_dir="${2:-/srv/mytoken-src}"
    if [ ! -x "$source_dir/deploy/install.sh" ]; then
      printf '%s\n' "Installer not found: $source_dir/deploy/install.sh" >&2
      exit 1
    fi
    as_root env MYTOKEN_SOURCE_DIR="$source_dir" "$source_dir/deploy/install.sh"
    ;;
  version)
    node -e 'const p=require(process.argv[1]); console.log(p.version)' "$install_dir/packages/cli/package.json"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
